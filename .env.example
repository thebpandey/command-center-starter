# Copy to .env.local for local development. Never commit real values.
# Supabase: Project Settings > API Keys (URL is in the Connect dialog or Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only secret key (sb_secret_...). SUPABASE_SERVICE_ROLE_KEY (legacy) also works if SUPABASE_SECRET_KEY is unset.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# The only email address allowed to log in.
OWNER_EMAIL=you@example.com
# Optional. IANA time zone for "today" and due dates. Default: America/Chicago
OWNER_TIMEZONE=America/Chicago
